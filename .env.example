# Copy to .env when you run the API, worker, or dispatcher on your machine.
# docker compose up does not need this file. It sets its own database hostnames.
APP_ENV=local
LOG_LEVEL=INFO

# postgres:// and postgresql:// are rewritten to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://webhook:webhook@localhost:5432/webhook
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_QUEUE=transactions

# The worker sleeps this long. The webhook response does not.
PROCESSING_DELAY_SECONDS=30
PROCESSING_LEASE_SECONDS=120
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=50
OUTBOX_VISIBILITY_TIMEOUT_SECONDS=180
